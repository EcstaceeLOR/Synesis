{
  "name": "synesis",
  "version": "0.1.0",
  "private": true,
  "description": "Paid intelligence. Proven execution.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build --concurrency=2",
    "dev": "turbo run dev --parallel",
