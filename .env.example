# Safe local defaults. Copy to .env and replace placeholders only when needed.
SYNESIS_MODE=demo
SYNESIS_WEB_ORIGINS=http://localhost:3000
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=synesis-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_AUTHORIZATION_URL=https://identity.example.com/authorize
OIDC_TOKEN_URL=https://identity.example.com/oauth/token
OIDC_CLIENT_ID=synesis-web
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
SYNESIS_PUBLIC_ORIGIN=http://localhost:3000
SYNESIS_API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
SYNESIS_API_PORT=4000
OLAS_ADAPTER_URL=http://localhost:8100
OLAS_ADAPTER_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
KEEPERHUB_GATEWAY_URL=http://api:4000/internal/v1/keeperhub/submit-call
KEEPERHUB_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
MECHX_CHAIN_RPC=
DATABASE_URL=postgresql://synesis:synesis@localhost:5432/synesis
REDIS_URL=redis://localhost:6379

# Never commit live credentials. These intentionally empty values enable no writes.
KEEPERHUB_API_KEY=
KEEPERHUB_WORKFLOW_ID=
BASE_RPC_URL=
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SYNESIS_SECRET_ENCRYPTION_KEY=
KEEPERHUB_API_ORIGIN=https://app.keeperhub.com
IPFS_PROBE_CID=bafybeiatwwblrphl6qmxfqzu7ose37drqlbkboqbisldwks772yif3buky
